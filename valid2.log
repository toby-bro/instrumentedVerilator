---------------------------------------------------------------\n// 3.  Duplicate CASE items (same comparisons)\n//---------------------------------------------------------------\nmodule dup_case\n    (input  logic [1:0] sel,\n     output logic [3:0] data);\n\n    always_comb begin\n        unique case (sel)\n            2'd0: data = 4'hA;\n            2'd1: data = 4'hB;\n            // Intentional duplicates of values above\n            2'd0: data = 4'hA;\n            2'd1: data = 4'hB;\n            default: data = 4'h0;\n        endcase\n    end\nendmodule\n\n//---------------------------------------------------------------\n// 4.  Function duplication inside a module\n//---------------------------------------------------------------\nmodule dup_function\n    (input  logic [7:0] in_val,\n     output logic [7:0] out_f1,\n     output logic [7:0] out_f2);\n\n    // Same function declared twice (body identical)\n    function automatic logic [7:0] f_calc_1 (input logic [7:0] x);\n        return (x ^ 8'hFF) + (x ^ 8'hFF);\n    endfunction\n\n    function automatic logic [7:0] f_calc_2 (input logic [7:0] x);\n        return (x ^ 8'hFF) + (x ^ 8'hFF);\n    endfunction\n\n    assign out_f1 = f_calc_1(in_val);\n    assign out_f2 = f_calc_2(in_val);\nendmodule\n\n//---------------------------------------------------------------\n// 5.  Duplicate struct manipulations\n//---------------------------------------------------------------\nmodule dup_struct\n    (input  logic clk,\n     input  logic rst_n,\n     input  logic [15:0] in_pay,\n     output logic [15:0] out_pay);\n\n    typedef struct packed {\n        logic [7:0]  upper;\n        logic [7:0]  lower;\n    } payload_t;\n\n    payload_t p1, p2;\n\n    always_ff @(posedge clk or negedge rst_n) begin\n        if (!rst_n) begin\n            p1 <= '{upper:8'h0, lower:8'h0};\n            p2 <= '{upper:8'h0, lower:8'h0};\n        end\n        else begin\n            // Same assignment duplicated deliberately\n            p1.upper <= in_pay[15:8];\n            p1.lower <= in_pay[7:0];\n            p2.upper <= in_pay[15:8];   // Duplicate of p1 assignment\n            p2.lower <= in_pay[7:0];    // Duplicate of p1 assignment\n        end\n    end\n\n    assign out_pay = {p2.upper, p2.lower};\nendmodule\n\n//---------------------------------------------------------------\n// 6.  Duplicate generate blocks (implicit hierarchy only)\n//---------------------------------------------------------------\nmodule dup_generate\n    (input  logic  ctrl,\n     output logic [3:0] y);\n\n    logic [3:0] internal0;\n    logic [3:0] internal1;\n\n    // Two generate-for loops that create identical logic\n    genvar i;\n    generate\n        for (i = 0; i < 4; i++) begin : G0\n            assign internal0[i] = ctrl & 1'b1;\n        end\n        for (i = 0; i < 4; i++) begin : G1\n            assign internal1[i] = ctrl & 1'b1;  // Exact duplicate of G0 body\n        end\n    endgenerate\n\n    assign y = internal0 | internal1;\nendmodule\n\n//---------------------------------------------------------------\n// 7.  Class instantiation inside procedural blocks\n//---------------------------------------------------------------\nmodule dup_class\n    (input  logic [7:0] din,\n     output logic [7:0] dout);\n\n    // Simple class with a repeatable method\n    class simple_c;\n        function automatic logic [7:0] pass_thru (input logic [7:0] x);\n            return (x);               // Identity function (duplicated)\n        endfunction\n    endclass\n\n    always_comb begin\n        // Two identical class instances created each time\n        automatic simple_c c1 = new();\n        automatic simple_c c2 = new();\n        dout = c1.pass_thru(din) ^ c2.pass_thru(din);  // Duplicate computations\n    end\nendmodule\n\n//---------------------------------------------------------------\n// 8.  Packed array duplication inside continuous assignments\n//---------------------------------------------------------------\nmodule dup_array\n    (input  logic [3:0] in_arr,\n     output logic [3:0] out_arr);\n\n    // Same packed array slice used multiple times\n    wire duplicate0 = &in_arr[3:2];\n    wire duplicate1 = &in_arr[3:2];   // Intentional duplicate\n\n    assign out_arr = {duplicate0, duplicate1, duplicate0, duplicate1};\nendmodule\n```", role='assistant', tool_calls=None, function_call=None, provider_specific_fields={'refusal': None}, annotations=[]))], usage=Usage(completion_tokens=3033, prompt_tokens=2140, total_tokens=5173, completion_tokens_details=CompletionTokensDetailsWrapper(accepted_prediction_tokens=0, audio_tokens=0, reasoning_tokens=1600, rejected_prediction_tokens=0, text_tokens=None), prompt_tokens_details=PromptTokensDetailsWrapper(audio_tokens=0, cached_tokens=0, text_tokens=None, image_tokens=None)), service_tier='default')
