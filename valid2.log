ogic data;\nendinterface\n\n// ---------------------------------------------------------------\n// Consumer of a single interface instance\n// ---------------------------------------------------------------\nmodule intf_consumer (\n    ifbus           b,\n    input  logic    sel,\n    output logic    out\n);\n    assign out = sel ? b.data : 1'b0;\nendmodule\n\n// ---------------------------------------------------------------\n// Demonstrates arrayed module instantiation with vector slicing\n// ---------------------------------------------------------------\nmodule parent_array (\n    input  logic [31:0] din,\n    output logic [31:0] dout\n);\n    // Unpacked arrays of vectors to feed each instance\n    logic [7:0] seg_in  [0:3];\n    logic [7:0] seg_out [0:3];\n\n    // Break the wide vector into segments\n    assign seg_in[0] = din[ 7: 0];\n    assign seg_in[1] = din[15: 8];\n    assign seg_in[2] = din[23:16];\n    assign seg_in[3] = din[31:24];\n\n    // Arrayed instantiation of four identical leaves\n    leaf_simple u_leaf [0:3] ( .d(seg_in), .q(seg_out) );\n\n    // Re-assemble the output\n    assign dout = { seg_out[3], seg_out[2], seg_out[1], seg_out[0] };\nendmodule\n\n// ---------------------------------------------------------------\n// Parent that widens a 4-bit vector to an 8-bit port (extension)\n// ---------------------------------------------------------------\nmodule parent_extend (\n    input  logic [3:0] din,\n    output logic [7:0] dout\n);\n    child8 u_ext ( .d(din), .q(dout) );   // width extend case\nendmodule\n\n// ---------------------------------------------------------------\n// Parent that selects 4 LSBs from an 8-bit vector (selection)\n// ---------------------------------------------------------------\nmodule parent_slice (\n    input  logic [7:0] din,\n    output logic [3:0] dout\n);\n    child4 u_sel ( .d(din[3:0]), .q(dout) );   // slice/select case\nendmodule\n\n// ---------------------------------------------------------------\n// Parent that creates an array of interfaces and an array of\n// module instances, exercising interface arrays\n// ---------------------------------------------------------------\nmodule intf_parent (\n    input  logic [1:0] sel,\n    output logic [1:0] out\n);\n    // Array of interface instances\n    ifbus bus_array [0:1] ();\n\n    // Drive each interface element\n    assign bus_array[0].data = sel[0];\n    assign bus_array[1].data = sel[1];\n\n    // Array-style scalar signals for per-instance connections\n    logic sel_arr [0:1];\n    assign sel_arr[0] = sel[0];\n    assign sel_arr[1] = sel[1];\n\n    // Outputs from each consumer\n    logic out_arr [0:1];\n\n    // Arrayed instantiation using interface array\n    intf_consumer consumers [0:1] ( bus_array, sel_arr, out_arr );\n\n    // Pack the array of individual outputs into a vector\n    assign out = { out_arr[1], out_arr[0] };\nendmodule\n\n// ---------------------------------------------------------------\n// Parent that selects a single element from an interface array\n// and passes it to a sub-module\n// ---------------------------------------------------------------\nmodule intf_index_user (\n    ifbus        b,\n    output logic out\n);\n    assign out = b.data;\nendmodule\n\nmodule intf_index_parent (\n    input  logic sel,\n    output logic out\n);\n    // Four-element interface array\n    ifbus bus_arr [0:3] ();\n\n    // Drive only element 2\n    assign bus_arr[2].data = sel;\n\n    // Pass a single array element (constant index) to child\n    intf_index_user iu ( .b(bus_arr[2]), .out(out) );\nendmodule\n```", role='assistant', tool_calls=None, function_call=None, provider_specific_fields={'refusal': None}, annotations=[]))], usage=Usage(completion_tokens=6489, prompt_tokens=13255, total_tokens=19744, completion_tokens_details=CompletionTokensDetailsWrapper(accepted_prediction_tokens=0, audio_tokens=0, reasoning_tokens=5376, rejected_prediction_tokens=0, text_tokens=None), prompt_tokens_details=Promp