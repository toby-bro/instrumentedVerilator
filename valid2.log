======\nmodule width_param_default\n#(\n    // Call macro without overriding the default argument\n    parameter int WIDTH = `WIDTH_MACRO()\n)\n(\n    input  logic [WIDTH-1:0]  data_i,\n    output logic [WIDTH-1:0]  data_o\n);\n    // Invoke multi-line macro inside an always_comb block\n    always_comb begin\n        `MULTI_LINE(\n            data_o = data_i;   // simple pass-through\n        )\n    end\nendmodule\n\n//==============================================================\n// Module: comment_variations\n// Exercises: block comments, line comments, backslash-newline in comments\n//==============================================================\nmodule comment_variations\n(\n    input  logic in_sig,\n    output logic out_sig\n);\n    /* A C-style comment that \\\n       spans multiple lines and uses a backslash at the end of line \\\n    */\n    // Single line comment with Verilator pragma style                     // verilator lint_off UNUSED\n\n    assign out_sig = in_sig;  // Basic connection to satisfy elaboration\nendmodule\n\n//==============================================================\n// Module: ifdef_feature\n// Exercises: `ifdef / `else / `endif conditional compilation\n//==============================================================\n`define FEATURE_FLAG\nmodule ifdef_feature\n(\n    input  logic  d_in,\n    output logic  d_out\n);\n`ifdef FEATURE_FLAG\n    assign d_out = d_in;\n`else\n    assign d_out = ~d_in;\n`endif\nendmodule\n\n//==============================================================\n// Module: protect_pragmas_holder\n// Exercises: `pragma protected related tokens (skipped by `ifdef)\n//==============================================================\nmodule protect_pragmas_holder\n(\n    input  logic sig_i,\n    output logic sig_o\n);\n`ifdef NEVER_PROTECT      // kept false so that synthesis is unaffected\n`pragma protect begin_protected\n`pragma protect encoding  = (enctype = "base64", line_length = 64, bytes = 16)\n`pragma protec