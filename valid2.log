 several paths\n        if (a[1]) begin\n            y1 = a[1] & b[1];\n        end else if (b[1]) begin\n            y1 = a[1] | b[1];\n        end else begin\n            y1 = 1'b0;\n        end\n\n        // y2/y3 may be partially unassigned to exercise table logic\n        case (a[3:2])\n            2'b00: begin\n                y2 = a[2];\n                y3 = b[2];\n            end\n            2'b01: begin\n                y2 = a[3];\n                // y3 intentionally left untouched\n            end\n            2'b10: begin\n                y3 = b[3];\n                // y2 intentionally left untouched\n            end\n            default: begin\n                y2 = 1'b0;\n                y3 = 1'b0;\n            end\n        endcase\n    end\nendmodule\n\n\n// Module 3: Many continuous assignments to create AstNodeAssign activity\nmodule many_assigns (\n    input  logic [15:0] inp,\n    output wire  [15:0] out0,\n    output wire  [15:0] out1,\n    output wire  [15:0] out2,\n    output wire  [15:0] out3\n);\n    assign out0 = inp;\n    assign out1 = ~inp;\n    assign out2 = {inp[7:0], inp[15:8]};\n    assign out3 = inp ^ 16'h55AA;\nendmodule\n\n\n// Module 4: Array access with concatenation to exercise AstArraySel and AstConcat\nmodule array_concat (\n    input  logic [1:0] idx,\n    output logic [7:0] o\n);\n    logic [7:0] mem [0:3];\n\n    // Simple combinational read/concatenation\n    always_comb begin\n        o = {mem[idx][7:4], mem[idx][3:0]};\n    end\nendmodule\n\n\n// Module 5: Real-number processing to exercise double precision paths\nmodule real_process (\n    input  real  rin,\n    input  logic sel,\n    output real  rout\n);\n    always_comb begin\n        if (sel) begin\n            rout = rin * 2.0;\n        end else begin\n            // rout may stay unchanged on some paths\n        end\n    end\nendmodule\n\n\n// Module 6: Large case statement exceeding TABLE_MIN_NODE_COUNT\nmodule case_table (\n    input  logic [4:0] sel,\n    output 