---------------------------------------\n// Class with randomize(), new(), with-constraint, static constraint,\n// and local:: reference\nmodule new_with_mod (\n    input  logic       clk,\n    output logic [1:0] value\n);\n    class RandC;\n        rand bit [1:0] var;\n        static constraint c_st { local::var inside {[0:3]}; }\n    endclass\n\n    RandC obj;\n\n    always_ff @(posedge clk) begin\n        if (obj == null) obj = new;\n        void'(obj.randomize() with { var inside {[0:3]}; });\n        value <= obj.var;\n    end\nendmodule\n\n// ------------------------------------------------------------------\n// Mailbox keyword demonstration\nmodule mailbox_mod (\n    input  logic       clk,\n    input  logic       wr,\n    output logic [7:0] q\n);\n    mailbox #(byte) mb;\n    byte tmp;\n    always_ff @(posedge clk) begin\n        // Presence of mailbox variable exercises parser; methods optional\n        if (wr) tmp <= 8'hAA;\n        q <= tmp;\n    end\nendmodule\n\n// ------------------------------------------------------------------\n// Semaphore keyword demonstration\nmodule semaphore_mod (\n    input  logic clk,\n    output logic available\n);\n    semaphore sem;\n    always_ff @(posedge clk) begin\n        available <= (sem != null);  // Simple reference to semaphore handle\n    end\nendmodule\n\n// ------------------------------------------------------------------\n// Process keyword demonstration\nmodule process_mod (\n    input  logic clk,\n    output logic busy\n);\n    process p_handle;\n    always_ff @(posedge clk) begin\n        p_handle = process::self();\n        busy <= (p_handle != null);\n    end\nendmodule\n```", role='assistant', tool_calls=None, function_call=None, provider_specific_fields={'refusal': None}, annotations=[]))], usage=Usage(completion_tokens=6545, prompt_tokens=13894, total_tokens=20439, completion_tokens_details=CompletionTokensDetailsWrapper(accepted_prediction_tokens=0, audio_tokens=0, reasoning_tokens=5824, rejected_pr