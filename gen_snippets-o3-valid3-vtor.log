 assign data_out = counter;\nendmodule\n\n//-----------------------  Generate demo -----------------------\nmodule generate_mod #(\n    parameter int WIDTH = 8\n)(\n    input  logic                   clk,\n    input  logic [WIDTH-1:0]       in_bus,\n    output logic [WIDTH-1:0]       out_bus\n);\n    generate\n        if (WIDTH == 8) begin : gen_block_if\n            logic [WIDTH-1:0] r;\n            always_ff @(posedge clk) r <= in_bus;\n            assign out_bus = r;\n        end\n        else begin : gen_block_else\n            logic [WIDTH-1:0] r;\n            always_ff @(posedge clk) r <= in_bus;\n            assign out_bus = r;\n        end\n        for (genvar i = 0; i < 1; i++) begin : gen_for\n            // Empty loop body, only to exercise generate/for\n        end\n        case (WIDTH)\n            4  : begin : gen_case_small end\n            8  : begin : gen_case_mid   end\n            default: begin : gen_case_def end\n        endcase\n    endgenerate\nendmodule\n\n//-------------------  Loop/foreach/wait demo ------------------\nmodule loop_mod(\n    input  logic clk,\n    input  logic rst,\n    output logic done\n);\n    logic [7:0] mem [0:9];\n    int idx = 0;\n\n    // Populate using foreach and repeat\n    always_ff @(posedge clk) begin\n        if (rst) begin\n            idx <= 0;\n            foreach (mem[i]) mem[i] <= i;\n        end\n        else begin\n            idx <= idx + 1;\n            repeat (1) begin\n                if (idx > 9) idx <= 0;\n            end\n        end\n    end\n\n    // do/while inside combinational block\n    always_comb begin\n        int acc = 0;\n        int j = 0;\n        do begin\n            acc = acc + mem[j];\n            j++;\n        end while (j < 10);\n    end\n\n    // wait(0) statement inside always\n    always @(*) begin\n        wait (0);\n    end\n\n    assign done = (idx == 10);\nendmodule\n\n//-------------------  Clocking block exercise -----------------\nmodule clocking_mod(\n    input  logic clk,\n    input  logic din,\n    output logic dout\n);\n    clocking cb @(posedge clk);\n        input  din;\n        output dout;\n    endclocking\n\n    always_ff @(cb) begin\n        cb.dout <= cb.din;\n    end\nendmodule\n\n//---------------- Attribute-rich variable declarations --------\nmodule attribute_mod(\n    input  logic             clk,\n    input  logic [3:0]       data_in,\n    output logic [3:0]       data_out\n);\n    (* verilator public_flat        *) logic [3:0] flat_sig;\n    (* verilator public_flat_rw     *) logic [3:0] flat_sig_rw;\n    (* verilator public_flat_rd     *) logic [3:0] flat_sig_rd;\n    (* verilator forceable          *) logic [3:0] force_sig;\n    (* verilator isolate_assignments*) logic [3:0] isolate_sig;\n    (* verilator sformat            *) string      str_sig;\n    (* verilator split_var          *) logic [7:0] split_sig;\n    (* verilator sc_bv              *) logic [3:0] bv_sig;\n    (* verilator clocker            *) logic       clkr_sig;\n    (* verilator no_clocker         *) logic       noclkr_sig;\n\n    always_ff @(posedge clk) begin\n        flat_sig      <= data_in;\n        flat_sig_rw   <= data_in;\n        flat_sig_rd   <= flat_sig;\n        force_sig     <= data_in;\n        isolate_sig   <= data_in;\n        split_sig     <= {data_in, data_in};\n        bv_sig        <= data_in;\n        clkr_sig      <= clk;\n        noclkr_sig    <= clk;\n        str_sig       <= $sformatf("%0d", data_in);\n    end\n\n    assign data_out = flat_sig_rw;\nendmodule\n\n//-------------------- Event-control statement -----------------\nmodule eventcontrol_mod(\n    input  logic clk,\n    input  logic in_sig,\n    output logic out_sig\n);\n    logic toggle;\n\n    // Event control inside an always with no sensitivity list\n    always begin\n        @(posedge clk);\n        toggle <= ~toggle;\n    end\n\n    assign out_sig = toggle ^ in_sig;\nendmodule\n\n//-------------------  Parameter type demonstration ------------\nmodule p