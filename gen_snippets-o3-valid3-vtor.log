:0]}};        // replication\nendmodule\n\n// ---------------------------------------------------------------------------\n// Module 3: Reduction operators with signed/unsigned casting\nmodule reduction_ops (\n    input  logic [7:0] in_vec,\n    output logic       all_high,\n    output logic       any_high,\n    output logic       parity\n);\n    assign all_high = &in_vec;                // AND-reduction\n    assign any_high = |in_vec;                // OR-reduction\n    assign parity   = ^in_vec;                // XOR-reduction\nendmodule\n\n// ---------------------------------------------------------------------------\n// Module 4: Conditional (ternary) and part-select example\nmodule conditional_ops (\n    input  logic [31:0] src,\n    input  logic [1:0]  sel,\n    output logic [7:0]  out_byte\n);\n    // Select one of four bytes without case\n    assign out_byte = (sel == 2'd0) ? src[ 7: 0] :\n                      (sel == 2'd1) ? src[15: 8] :\n                      (sel == 2'd2) ? src[23:16] :\n                                      src[31:24];\nendmodule\n\n// ---------------------------------------------------------------------------\n// Module 5: Packed struct with functions and tasks\nmodule struct_func_task (\n    input  logic         clk,\n    input  logic [7:0]   din,\n    output logic [7:0]   dout\n);\n    typedef struct packed {\n        logic [3:0] lo;\n        logic [3:0] hi;\n    } nibbles_t;\n\n    function automatic nibbles_t swap(input nibbles_t val);\n        swap.lo = val.hi;\n        swap.hi = val.lo;\n    endfunction\n\n    task automatic void transform(input logic [7:0] in_val, output logic [7:0] out_val);\n        nibbles_t tmp;\n        tmp.lo = in_val[3:0];\n        tmp.hi = in_val[7:4];\n        tmp     = swap(tmp);\n        out_val = {tmp.hi, tmp.lo};\n    endtask\n\n    always_ff @(posedge clk) begin\n        transform(din, dout);\n    end\nendmodule\n\n// ---------------------------------------------------------------------------\n// Module 6: Unique case / priority if example with enum state machine\nmodule enum_state_machine (\n    input  logic       clk,\n    input  logic [1:0] cmd,\n    output logic [3:0] state_enc\n);\n    typedef enum logic [1:0] {S_IDLE=2'd0, S_RUN=2'd1, S_WAIT=2'd2, S_DONE=2'd3} state_t;\n    state_t state;\n\n    always_ff @(posedge clk) begin\n        unique case (state)\n            S_IDLE: if (cmd == 2'd1) state <= S_RUN;\n            S_RUN : if (cmd == 2'd2) state <= S_WAIT;\n            S_WAIT: if (cmd == 2'd3) state <= S_DONE;\n            default: state <= S_IDLE;\n        endcase\n    end\n\n    assign state_enc = {2'b00, state};\nendmodule\n\n// ---------------------------------------------------------------------------\n// Module 7: Assertion and cover property example (no delays)\nmodule assertion_cover (\n    input  logic clk,\n    input  logic rst_n,\n    input  logic tr,\n    output logic ok\n);\n    logic prev_tr;\n\n    always_ff @(posedge clk or negedge rst_n) begin\n        if (!rst_n) begin\n            prev_tr <= 1'b0;\n        end else begin\n            prev_tr <= tr;\n        end\n    end\n\n    // Simple property: pulse should not repeat in two consecutive cycles\n    property no_double_pulse;\n        @(posedge clk) disable iff (!rst_n)\n            !(tr && prev_tr);\n    endproperty\n\n    assert property (no_double_pulse);\n    cover  property (@(posedge clk) tr);\n\n    assign ok = !(!rst_n) && !(tr && prev_tr);\nendmodule\n\n// ---------------------------------------------------------------------------\n// Module 8: Multi-dimensional packed and unpacked arrays\nmodule array_multidim (\n    input  logic [3:0][7:0] in_mat,    // packed 2-D array\n    output logic [31:0]     flat_out\n);\n    assign flat_out = in_mat;          // automatic packing/unpacking\nendmodule\n\n// ---------------------------------------------------------------------------\n// Module 9: Generate constant masks using for-loop functions\nmodule mask_generator #(\n    parameter integer WIDTH = 16\n) (\n    input  logic [$clog2(WIDTH)-1:0] idx,\n    output logic [WIDTH-1:0] mask\n);\n    function automatic logic [WIDTH-1:0] gen_mask(input int id);\n        logic [WIDTH-1:0] tmp;\n        tmp = '0;\n        tmp[id] = 1'b1;\n        return tmp;\n    endfunction\n\n    assign mask = gen_mask(idx);\nendmodule\n\n// ---------------------------------------------------------------------------\n// Module 10: Priority and unique0 casez with don’t-care bits\nmodule casez_example (\n    input  logic [3:0] opcode,\n    output logic [1:0] action\n);\n    always_comb begin\n        unique0 casez (opcode)\n            4'b1???: action = 2'd3; // pattern with don’t-care\n            4'b01??: action = 2'd2;\n            4'b001?: action = 2'd1;\n            default: action = 2'd0;\n        endcase\n    end\nendmodule\n\n// ---------------------------------------------------------------------------\n// Module 11: Signed vs. unsigned arithmetic nuances\nmodule signed_unsigned (\n    input  logic signed [7:0] a,\n    input  logic        [7:0] b,\n    output logic signed [8:0] sum\n);\n    assign sum = a + $signed(b);   // explicit cast to signed for proper width\nendmodule\n\n// ---------------------------------------------------------------------------\n// Module 12: Logic with array slicing and streaming operators\nmodule streaming_slice (\n    input  logic [31:0] vec_in,\n    output logic [31:0] vec_out\n);\n    // Reverse byte order using stream\n    assign vec_out = {<<8{vec_in}};   // byte-swap\nendmodule\n\n// ---------------------------------------------------------------------------\n// Module 13: procedural always_comb with class instantiation inside\nmodule class_proc (\n    input  logic  [3:0] in_val,\n    output logic  [3:0] out_val\n);\n    class C;\n        bit [3:0] d;\n        function new(bit [3:0] v); d = v; endfunction\n        function bit [3:0] get(); return d; endfunction\n    endclass\n\n    always_comb begin\n        C c = new(in_val);          // class instantiation inside procedural block\n        out_val = c.get();\n    end\nendmodule\n\n// ---------------------------------------------------------------------------\n// Module 14: Large combinational expression to boost complexity score\nmodule big_expression (\n    input  logic [63:0] x,\n    output logic [63:0] y\n);\n    assign y = ((x ^ 64'hDEADBEEF_DEADBEEF) & 64'h0F0F0F0F_0F0F0F0F)\n             | ((x << 7) | (x >> 5))\n             | ({x[31:0], x[63:32]});\nendmodule\n\n// ---------------------------------------------------------------------------\n// Module 15: Boolean equations with generate-if blocks\nmodule generate_if #(parameter USE_AND = 1) (\n    input  logic a,\n    input  logic b,\n    output logic y\n);\n    generate\n        if (USE_AND) begin : blk_and\n            assign y = a & b;\n        end else begin : blk_or\n            assign y = a | b;\n        end\n    endgenerate\nendmodule\n\n// ---------------------------------------------------------------------------\n// Module 16: Interface declaration and usage without instantiation\ninterface simple_if #(parameter W = 8) ();\n    logic [W-1:0] dat;\n    modport mp (input dat);\nendinterface\n\nmodule interface_user (\n    input  logic clk,\n    input  logic [7:0] ext,\n    output logic [7:0] echo\n);\n    simple_if #(8) vif();   // virtual, no hierarchy generated\n    always_ff @(posedge clk) begin\n        vif.dat <= ext;\n    end\n    assign echo = vif.dat;\nendmodule\n\n// ---------------------------------------------------------------------------\n// Module 17: Packed union and type casting\nmodule packed_union_cast (\n    input  logic [15:0] in_data,\n    output logic [7:0]  out_hi,\n    output logic [7:0]  out_lo\n);\n    typedef union packed {\n        logic [15:0] word;\n        struct packed { logic [7:0] lo, hi; } bytes;\n    } u_t;\n\n    u_t u;\n    assign u.word = in_data;\n    assign out_lo = u.bytes.lo;\n    assign out_hi = u.bytes.hi;\nendmodule\n\n// ---------------------------------------------------------------------------\n// Module 18: Nested generate loops with localparams\nmodule nested_generate #(\n    parameter N = 4,\n    parameter M = 4\n) (\n    input  logic [N*M-1:0] in_flat,\n    output logic [N*M-1:0] out_flat\n);\n    genvar i, j;\n    generate\n        for (i = 0; i < N; i++) begin : g_row\n            for (j = 0; j < M; j++) begin : g_col\n                localparam int idx = i*M + j;\n                assign out_flat[idx] = ~in_flat[idx];\n            end\n        end\n    endgenerate\nendmodule\n\n// ---------------------------------------------------------------------------\n// Module 19: Simple combinational LUT using constant functions\nmodule lut4 (\n    input  logic [3:0] in,\n    output logic       out\n);\n    function logic lut(input logic [3:0] v);\n        // 16-bit truth table constant\n        logic [15:0] table = 16'h6996; // example pattern\n        return table[v];\n    endfunction\n\n    assign out = lut(in);\nendmodule\n\n// ---------------------------------------------------------------------------\n// Module 20: Parameterised counter with assertions\nmodule counter_param #(parameter MAX = 255) (\n    input  logic clk,\n    input  logic rst_n,\n    output logic [$clog2(MAX+1)-1:0] cnt\n);\n    always_ff @(posedge clk or negedge rst_n) begin\n        if (!rst_n) cnt <= '0;\n        else        cnt <= (cnt == MAX) ? '0 : cnt + 1'b1;\n    end\n\n    // Assert counter never exceeds MAX\n    assert property (@(posedge clk) cnt <= MAX);\nendmodule\n```", role='assistant', tool_calls=None, function_call=None, provider_specific_fields={'refusal': None}, annotations=[]))], usage=Usage(completion_tokens=4648, prompt_tokens=17134, total_tokens=21782, completion_tokens_details=CompletionTokensDetailsWrapper(accepted_prediction_tokens=0, audio_tokens=0, reasoning_tokens=1920, rejected_prediction_tokens=0, text_tokens=None), prompt_tokens_details=PromptTokensDetailsWrapper(audio_tokens=0, ca