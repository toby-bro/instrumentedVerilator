egin\n        static int w;\n        w = din;\n        fork\n            begin : outer_proc\n                fork\n                    begin\n                        w = w + 2;\n                    end\n                join_none\n            end\n        join_none\n        dout <= w[7:0];\n    end\nendmodule\n\n\nmodule fork_task_capture\n(\n    input  logic       clk,\n    input  logic [7:0] din,\n    output logic [7:0] dout\n);\n    task automatic addTen (ref int val);\n        val = val + 10;\n    endtask\n\n    always @(posedge clk) begin\n        static int q;\n        q = din;\n        fork\n            addTen(q);\n        join_none\n        dout <= q[7:0];\n    end\nendmodule\n\n\nmodule fork_nonblocking\n(\n    input  logic       clk,\n    input  logic [7:0] din,\n    output logic [7:0] dout\n);\n    logic [7:0] shared;\n\n    always @(posedge clk) begin\n        shared <= din;\n    end\n\n    always @(posedge clk) begin\n        fork\n            shared <= shared + 1;\n        join_none\n        dout <= shared;\n    end\nendmodule\n\n\nmodule fork_output_capture\n(\n    input  logic       clk,\n    input  logic [7:0] din,\n    output logic [7:0] dout\n);\n    always @(posedge clk) begin\n        static logic [7:0] local_out;\n        local_out <= din;\n        fork\n            begin\n                @(posedge clk);\n                local_out <= local_out + 8'h1;\n            end\n        join_none\n        dout <= local_out;\n    end\nendmodule\n```", role='assistant', tool_calls=None, function_call=None, provider_specific_fields={'refusal': None}, annotations=[]))], usage=Usage(completion_tokens=4154, prompt_tokens=14131, total_tokens=18285, completion_tokens_details=CompletionTokensDetailsWrapper(accepted_prediction_tokens=0, audio_tokens=0, reasoning_tokens=3328, rejected_prediction_tokens=0, text_tokens=None), prompt_tokens_details=PromptTokensDetailsWrapper(audio_tokens=0, cached_tokens=12416, text_tokens=None, image_tokens=None)), service_tier='defau