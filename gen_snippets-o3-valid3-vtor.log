p\n    cg_input cg_inst = new();\nendmodule\n\n\n//------------------------------------------------------------------------------\n// Module with multidimensional packed/unpacked arrays and public variables\nmodule array_mod\n    (input  logic  [3:0] sel,\n     output logic [15:0] dout /*verilator public*/);\n\n    typedef logic [7:0] byte_t;\n\n    // Two-dimensional unpacked array\n    byte_t mem2d [0:3][0:1] /*verilator public*/;\n\n    // Constant packed array parameter\n    localparam logic [7:0] CONST_VEC [0:3] = \'{8\'h11, 8\'h22, 8\'h33, 8\'h44};\n\n    // Combinational read\n    always_comb begin\n        dout = {mem2d[sel[1:0]][sel[3:2]], 8\'h00};\n    end\nendmodule\n\n\n//------------------------------------------------------------------------------\n// Module importing a class from a package and exercising package scope handling\nmodule class_pkg_usage_mod\n    (input  logic [7:0] din,\n     output logic [7:0] dout);\n\n    // Import the package namespace\n    import pkg_classes::*;\n\n    // Build helper to construct class at elaboration time\n    function automatic MyClass build_obj();\n        build_obj = new();\n    endfunction\n\n    MyClass c = build_obj();   // Handle to class package instance\n\n    // Use class data in simple combinational logic\n    always_comb begin\n        dout = din ^ c.get();\n    end\nendmodule\n\n\n//------------------------------------------------------------------------------\n// Module with SystemVerilog events and event triggering\nmodule event_mod\n    (input  logic clk,\n     input  logic trigger,\n     output logic toggled /*verilator public*/);\n\n    event ev;\n\n    // Trigger the event\n    always_ff @(posedge clk) begin\n        if (trigger) -> ev;\n    end\n\n    // React to the event\n    always_ff @(ev) begin\n        toggled <= ~toggled;\n    end\nendmodule\n```', role='assistant', tool_calls=None, function_call=None, provider_specific_fields={'refusal': None}, annotations=[]))], usage=Usage(completion_t