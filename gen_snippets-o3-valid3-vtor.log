c\n    end\nendmodule\n\n// ======================================================================\n// While Loop With Increment Module\nmodule while_mod (\n    input  logic       clk,\n    input  logic       start,\n    output logic [3:0] out_cnt\n);\n    logic [3:0] cnt;\n    always_ff @(posedge clk) begin\n        if (start) begin\n            cnt = '0;\n            while (cnt < 4'd10) begin\n                cnt++;                  // loop increment\n            end\n        end\n        out_cnt <= cnt;\n    end\nendmodule\n\n// ======================================================================\n// Foreach Loop With Increment Module\nmodule foreach_mod (\n    input  logic       clk,\n    input  logic [7:0] in_val,\n    output logic [7:0] out_sum\n);\n    logic [7:0] arr [0:3];\n    always_ff @(posedge clk) begin\n        // load array\n        arr[0] <= in_val;\n        arr[1] <= in_val + 1;\n        arr[2] <= in_val + 2;\n        arr[3] <= in_val + 3;\n        // foreach with side-effect\n        foreach (arr[i]) begin\n            arr[i]++;                  // increment each entry\n        end\n        out_sum <= arr[0] + arr[1] + arr[2] + arr[3];\n    end\nendmodule\n\n// ======================================================================\n// Wait Statement With Increment Module\nmodule wait_mod (\n    input  logic clk,\n    input  logic trigger,\n    input  logic done,\n    output logic [3:0] value\n);\n    logic [3:0] regv;\n    always_ff @(posedge clk) begin\n        if (trigger) begin\n            wait (done);               // wait until done is asserted\n            regv++;                    // increment afterwards\n        end\n        value <= regv;\n    end\nendmodule\n\n// ======================================================================\n// Event-Control (posedge / or) With Increment Module\nmodule event_control_mod (\n    input  logic        clk,\n    input  logic        rst,\n    input  logic [15:0] in_val,\n    output logic [15:0] out