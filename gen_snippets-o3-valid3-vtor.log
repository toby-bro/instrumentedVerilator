ion inside procedural block (emitDereference paths)\nclass simple_class;\n    int value;\n    function new(int v = 0); value = v; endfunction\n    function int get(); return value; endfunction\nendclass\n\nmodule class_mod (\n    input  int in_data,\n    output int out_data\n);\n    simple_class c;\n    always_comb begin\n        if (c == null) c = new(in_data);\n        out_data = c.get();\n    end\nendmodule\n\n// Module with queue initialization (QueueDType handling)\nmodule queue_mod (\n    input  byte in_byte,\n    output byte front_byte\n);\n    byte q[$] = \'{8\'h10, 8\'h20, 8\'h30};\n    always_comb begin\n        if (q.size() != 0)\n            front_byte = q[0];\n        else\n            front_byte = in_byte;\n    end\nendmodule\n\n// Module using packed struct with initial value (Struct handling)\ntypedef struct packed {\n    logic [7:0] b0;\n    logic [7:0] b1;\n} pkt_t;\n\nmodule struct_mod (\n    input  pkt_t in_pkt,\n    output logic [7:0] sum\n);\n    pkt_t default_pkt = \'{8\'hAA, 8\'h55};\n    assign sum = in_pkt.b0 + in_pkt.b1 + default_pkt.b0 + default_pkt.b1;\nendmodule\n```', role='assistant', tool_calls=None, function_call=None, provider_specific_fields={'refusal': None}, annotations=[]))], usage=Usage(completion_tokens=4644, prompt_tokens=14841, total_tokens=19485, completion_tokens_details=CompletionTokensDetailsWrapper(accepted_prediction_tokens=0, audio_tokens=0, reasoning_tokens=3840, rejected_prediction_tokens=0, text_tokens=None), prompt_tokens_details=PromptTokensDetailsWrapper(audio_tokens=0, cached_tokens=0, text_tokens=None, image_tokens=None)), service_tier='default')
