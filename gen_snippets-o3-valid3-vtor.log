\n);\n    class CM_Class;\n        rand bit [7:0] num;\n        constraint num_c { num < 8\'h80; }\n    endclass\n\n    always @(*) begin\n        CM_Class cm = new();\n        cm.num_c.constraint_mode(seed[0]); // Enable/disable constraint\n        void\'(cm.randomize());\n        result = cm.num;\n    end\nendmodule\n\n\n// randc variable randomization\nmodule randc_mod (\n    input  logic clk_en,\n    output logic [3:0] cyc_val\n);\n    class RC_Class;\n        randc bit [3:0] cyc;\n    endclass\n\n    always @(*) begin\n        RC_Class rc = new();\n        void\'(rc.randomize());\n        cyc_val = rc.cyc;\n    end\nendmodule\n\n\n// Dynamic array randomization with size constraint and foreach\nmodule dyn_array_mod (\n    input  logic [3:0] idx,\n    output logic [7:0] datum\n);\n    class DA_Class;\n        rand bit [7:0] arr [];\n        constraint c_size { arr.size() == 4; }\n        constraint c_vals { foreach (arr[i]) arr[i] inside {[0:255]}; }\n    endclass\n\n    always @(*) begin\n        DA_Class da = new();\n        void\'(da.randomize());\n        datum = da.arr[idx & 2\'d3];\n    end\nendmodule\n\n\n// Associative array randomization with string keys\nmodule assoc_array_mod (\n    input  logic [7:0] key,\n    output logic [7:0] val\n);\n    class AA_Class;\n        rand bit [7:0] aarr [string];\n        constraint c_keys { foreach (aarr[k]) aarr[k] inside {[0:255]}; }\n    endclass\n\n    always @(*) begin\n        AA_Class aa = new();\n        void\'(aa.randomize());\n        val = aa.aarr[$sformatf("%0d", key)];\n    end\nendmodule\n\n\n// Struct randomization with inline constraint\nmodule struct_mod (\n    input  logic [3:0] sel,\n    output logic [7:0] struct_out\n);\n    typedef struct packed { bit [3:0] a; bit [3:0] b; } packed_s;\n\n    class ST_Class;\n        rand packed_s s;\n    endclass\n\n    always @(*) begin\n        ST_Class st = new();\n        void\'(st.randomize() with { st.s.a == sel; });\n        struct_out = {st.s.a, st.s.b};\